{
  "name": "brand-banners",
  "version": "0.2.0",
  "description": "Drop-in promo banners for your own courses, products and brands. One React component for a rotating corner card, plus strips, branded and media banners. Works in Vite, Next.js and any React app; no ad network, no tracking.",
  "type": "module",
  "license": "MIT",
  "author": "Mark Cole MUKISA <markcole683@gmail.com>",
  "contributors": [
    "MUKE JOHNBAPTIST (original author of beautiful-banner-ads)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarkColeMukisa/brand-banners.git"
  },
  "homepage": "https://github.com/MarkColeMukisa/brand-banners#readme",
  "bugs": {
    "url": "https://github.com/MarkColeMukisa/brand-banners/issues"
  },
  "keywords": [
    "react",
    "banner",
    "banner-ads",
    "house-ads",
    "promo",
    "promotion",
    "self-promotion",
    "first-party-ads",
    "course-promo",
    "react-component",
    "nextjs",
    "vite",
    "tailwind",
    "typescript",
    "ssr"
  ],
  "sideEffects": [
    "./dist/styles.css",
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind-preset": {
      "import": {
        "types": "./dist/tailwind-preset.d.ts",
        "default": "./dist/tailwind-preset.js"
      },
      "require": {
        "types": "./dist/tailwind-preset.d.cts",
        "default": "./dist/tailwind-preset.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.17"
  }
}
